# DRRMO EAMS environment template.
# Copy to .env and fill in values. Never commit .env or real secrets.

APP_NAME="DRRMO EAMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Times are stored in UTC. The UI shows this zone.
APP_DISPLAY_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail defaults. On a server, use a dedicated MySQL user with a strong password.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=drrmo_eams
DB_USERNAME=sail
DB_PASSWORD=password

# Sessions: 8 hours so a long shift does not log people out.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Auth: JWT in HttpOnly cookies (config/jwt.php). Generate the secret with: php artisan jwt:secret
JWT_SECRET=
# Access token lifetime in seconds, refresh token lifetime in days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7
# Set to true in production (HTTPS only). Browsers drop Secure cookies on plain http.
JWT_SECURE_COOKIES=false
# Origins allowed to make state changing API calls. Production: the real https origin only.
AUTH_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Local mail goes to Mailpit (http://localhost:8025).
# Production example (Brevo): MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
# tls (STARTTLS, usually port 587), ssl (port 465) or empty. With MAIL_MAILER=log the message goes to storage/logs/laravel.log.
MAIL_ENCRYPTION=
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="drrmo-noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# Warn admins when today's sends reach this number (Brevo free is about 300 a day).
MAIL_DAILY_LIMIT=300

# First admin account created by AdminUserSeeder. Use a real address only in your own .env.
SEED_ADMIN_EMAIL=admin@example.test

# Privacy
PRIVACY_NOTICE_VERSION=2026-11-v1
PRIVACY_CONTACT_EMAIL=privacy@example.test
PING_RETENTION_WORKING_DAYS=10

# Map. Leave the key empty to use OpenStreetMap only.
VITE_APP_NAME="${APP_NAME}"
VITE_MAP_CENTER_LAT=6.91212
VITE_MAP_CENTER_LNG=122.05909
VITE_ARCGIS_API_KEY=

# Proxy IPs to trust for https and host headers, for example 127.0.0.1 with a local cloudflared tunnel.
TRUSTED_PROXIES=
